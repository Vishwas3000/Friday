# Optional local overrides. Copy to .env and load explicitly with uv --env-file.
# Keep personal device identifiers in .env, which is ignored by Git.
FRIDAY_ADB=adb
# Leave empty to let adb select the single connected device.
FRIDAY_DEVICE_SERIAL=
# Local forwarded diagnostic bridge used by scripts/writer_test.py.
FRIDAY_BRIDGE_HOST=127.0.0.1
FRIDAY_BRIDGE_PORT=8765
